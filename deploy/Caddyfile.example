# Example Caddy site block for a CJS Portfolio build. Replace example.com and the root path.
# Caddy gets HTTPS certificates automatically. Reload with: caddy reload --config /etc/caddy/Caddyfile

www.example.com {
	redir https://example.com{uri} permanent
}

example.com {
	root * /var/www/example.com
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		# CSS is inlined; each page's <meta> CSP narrows style-src to that block's sha256
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		# Only with the optional Google tag (site.local.json / GOOGLE_TAG_ID): use this line instead of the one above
		# Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; script-src 'self' https://*.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}

	# HTML: always revalidate, so a deploy shows up immediately
	@pages path / *.html
	header @pages Cache-Control "no-cache"

	# anything with ?v=<hash> is content-addressed by the build: cache forever
	@versioned query v=*
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	@media {
		path *.png *.jpg *.svg *.webmanifest
		not query v=*
	}
	header @media Cache-Control "public, max-age=604800"

	@text path /robots.txt /sitemap.xml /llms.txt /llms-full.txt /humans.txt
	header @text Cache-Control "public, max-age=3600"

	@unversioned {
		path *.js
		not query v=*
	}
	header @unversioned Cache-Control "public, max-age=300"

	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json; charset=utf-8"
	@txt path *.txt
	header @txt Content-Type "text/plain; charset=utf-8"
	@notfoundpage path /404.html
	header @notfoundpage X-Robots-Tag "noindex"

	# serve the .br / .gz files the build wrote next to each text file
	file_server {
		precompressed br gzip
	}

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			header X-Robots-Tag "noindex"
			header Cache-Control "no-cache"
			rewrite * /404.html
			file_server {
				precompressed br gzip
			}
		}
	}
}
